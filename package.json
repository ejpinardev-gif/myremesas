{
  "name": "myremesas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "jose": "^6.2.12"
  },
  "scripts": {
    "start": "node server.js",
    "build": "tailwindcss -i ./public/styles/input.css -o ./public/styles/output.css",
    "test": "node --test tests/firebase-auth.test.mjs tests/binance-balance.test.mjs tests/order-validation.test.mjs tests/order-notifications.test.mjs tests/frontend-contract.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-myremesas-rules --only firestore,storage \"node --test tests/*.test.mjs\"",
    "test:function": "firebase emulators:exec --project demo-myremesas-rules --only auth,firestore,storage,functions \"node functions/create-order-smoke.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1"
  }
}
